# На сервере этот файл создаёт деплой (deploy/setup-server.sh) — руками ничего писать не нужно.
# Здесь только то, без чего API не запустится. Адрес сайта, CORS и почта SMTP
# настраиваются в админке: Система → Адреса и почта.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=balesnolandia
DB_USER=balesnolandia
DB_PASSWORD=change-me

# Генерируется деплоем: openssl rand -hex 32
JWT_SECRET=change-me
COOKIE_DOMAIN=.vladinc.ru
COOKIE_SECURE=true

# Эти адреса при регистрации получают роль admin (деплой берёт их из секрета ADMIN_EMAILS)
ADMIN_EMAILS=

# ——— Необязательно, для локальной разработки ———
# MAIL_TRANSPORT=console      # письма в лог
# PUBLIC_WEB_URL=http://localhost:5173/balesnolandia
# CORS_ORIGINS=http://localhost:5173
# GAME_CLOCK=on
