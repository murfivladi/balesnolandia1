# Скопируйте в .env на VPS. Этот файл — образец, без настоящих паролей.
NODE_ENV=production
PORT=3100
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bln
DB_PASSWORD=change-me
DB_NAME=balesnolandia

# Длинная случайная строка: openssl rand -hex 32
JWT_SECRET=change-me
# Домен cookie сессий: ведущая точка — общий для vladinc.ru и api.vladinc.ru
COOKIE_DOMAIN=.vladinc.ru
COOKIE_SECURE=true
# Откуда разрешены запросы фронтенда (через запятую)
CORS_ORIGINS=https://vladinc.ru,https://www.vladinc.ru
# Публичный адрес фронтенда — для ссылок в письмах и QR
PUBLIC_WEB_URL=https://vladinc.ru/balesnolandia

# Эти адреса при регистрации автоматически получают роль admin
ADMIN_EMAILS=

# Почта: smtp | console (console — печатать письма в лог, для разработки)
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Балесноландия <no-reply@vladinc.ru>"

# Игровой таймер (выключите на втором экземпляре API, если их несколько)
GAME_CLOCK=on
