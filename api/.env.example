# Для разработки: скопируйте в api/.env.
# На хостинге этот файл не нужен — деплой собирает bln.env из секретов репозитория.
# Адрес сайта, CORS и почта SMTP настраиваются в админке: Система → Адреса и почта.

NODE_ENV=development
PORT=3100

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bln
DB_USER=bln
DB_PASSWORD=bln

# Эти адреса при регистрации получают роль admin
ADMIN_EMAILS=

# Письма с кодами входа — в лог
MAIL_TRANSPORT=console

# Необязательно:
# JWT_SECRET=...        # в продакшене без него секрет создаётся и хранится в базе
# MIGRATE_ON_START=true # в продакшене включено по умолчанию
# GAME_CLOCK=on
# VAPID_PUBLIC_KEY=...  # ключи Web Push (base64url); без них создаются один раз и хранятся в базе
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:admin@example.com  # контакт для push-сервисов; по умолчанию — https-адрес сайта
